# LANDGUARD Environment Variables
# SIH26001 — AI-Powered Landslide Early Warning & Impact Monitoring (NER)

# Google Maps Platform API Key (Optional — fallback is Leaflet OpenStreetMap Demo Mode)
VITE_GOOGLE_MAPS_API_KEY=

# OpenWeather API Key (Optional — fallback is DEMO WEATHER MODE with realistic NER conditions)
OPENWEATHER_API_KEY=

# Database URL (Optional — defaults to persistent SQLite db at ./data/landguard.sqlite)
DATABASE_URL=sqlite:///./data/landguard.sqlite

# JWT Secret Key for authenticating DISASTER_AUTHORITY, ADMIN, FIELD_OPERATOR, and CITIZEN
SECRET_KEY=landguard_super_secret_jwt_key_sih26001_ner

# Gemini API Key (Server-side AI analysis for hazard report imagery and explanations)
GEMINI_API_KEY=

# Application URL
APP_URL=http://localhost:3000
